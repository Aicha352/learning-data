# Copie ce fichier en .env puis adapte les valeurs.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=learning_data
POSTGRES_USER=learning_data
POSTGRES_PASSWORD=learning_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Frontend (CORS + liens dans les e-mails) ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cookies d'authentification ---
# Mettre True uniquement si le site est servi en HTTPS.
AUTH_COOKIE_SECURE=False

# --- Machine learning ---
ML_ARTIFACTS_DIR=ml_artifacts
ML_TRAIN_IN_BACKGROUND=True

# --- E-mails (par défaut : affichés dans la console) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Learning Data <no-reply@learningdata.app>
